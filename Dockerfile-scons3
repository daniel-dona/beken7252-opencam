# Use Ubuntu 22.04 as base image to match original Dockerfile
FROM ubuntu:22.04

# Install system updates and essential packages
RUN apt-get update && apt-get upgrade -y

# Install Python 3 and build tools (no Python 2 needed for Python 3 SCons)
RUN apt-get install -y \
    python3 \
    python3-pip \
    build-essential \
    minicom \
    libc6-dev-i386 \
    micro-httpd \
    && rm -rf /var/lib/apt/lists/*

# Create python symlink for SCons compatibility
RUN ln -s /usr/bin/python3 /usr/bin/python

# Create necessary directories
RUN mkdir -p /build /tools

# Copy SCons source and install manually to match original approach
COPY ./scons-3.1.2/ /tools/scons/

# Install SCons manually using Python 3
WORKDIR /tools/scons/
RUN python3 setup.py install --prefix=/tools/scons/

# Copy flasher tools and install requirements
COPY ./hid_download_py/ /tools/flasher/
WORKDIR /tools/flasher/
RUN python3 -m pip install -r requirements.txt

# Copy GCC toolchain
COPY ./gcc-arm-none-eabi-5_4-2016q3/ /tools/gcc/

# Copy build script
COPY ./build.sh /build.sh

# Make build.sh executable
RUN chmod +x /build.sh

# Expose common ports
EXPOSE 8888 2345

# Use ENTRYPOINT to match original Dockerfile behavior
ENTRYPOINT ["/bin/bash", "/build.sh"]